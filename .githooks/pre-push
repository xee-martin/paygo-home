#!/bin/sh
set -eu
"$(git rev-parse --show-toplevel)/.githooks/check-identity"
case "$2" in
  https://github.com/xee-martin/paygo-home.git) ;;
  *) echo 'Blocked: push destination must be https://github.com/xee-martin/paygo-home.git' >&2; exit 1 ;;
esac
auth_dir="$(git rev-parse --absolute-git-dir)/gh-xee-martin"
account=$(env -u GH_TOKEN -u GITHUB_TOKEN GH_HOST=github.com GH_CONFIG_DIR="$auth_dir" gh api user --jq .login)
[ "$account" = xee-martin ] || { echo 'Blocked: authenticated account must be xee-martin' >&2; exit 1; }
while read -r local_ref local_oid remote_ref remote_oid; do
  case "$local_oid" in 0000000000000000000000000000000000000000) continue ;; esac
  invalid=$(git log "$local_oid" --format='%an <%ae>|%cn <%ce>' | awk '$0 != "xee-martin <344557589+xee-martin@users.noreply.github.com>|xee-martin <344557589+xee-martin@users.noreply.github.com>" { print; exit }')
  [ -z "$invalid" ] || { echo 'Blocked: pushed history contains an unexpected author or committer' >&2; exit 1; }
done
